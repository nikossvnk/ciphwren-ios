        "NSRemindersUsageDescription": "Access to your reminders is needed in order to load and save Ciphwren reminders.",
        "UIBackgroundModes": [
          "fetch"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "publishBundlePath": "ios/ciphwren/Supporting/shell-app.bundle",
      "publishManifestPath": "ios/ciphwren/Supporting/shell-app-manifest.json"
    },
    "isDetached": true,
    "detach": {
      "iosExpoViewUrl": "https://s3.amazonaws.com/exp-exponent-view-code/ios-v2.14.2-sdk36.0.0-e055f8a6-47bf-455c-9f14-d5a631ea2dd3.tar.gz",
      "androidExpoViewUrl": "https://s3.amazonaws.com/exp-exponent-view-code/android-v2.14.0-sdk36.0.0-fb8689e6-fd42-4b18-b01f-ac2ef3bc8681.tar.gz"
    },
    "scheme": "exp2904f03229f24a3ca9b3fcd8485120ca",
    "android": {
      "package": "com.ciphwren.ios",
      "publishBundlePath": "android/app/src/main/assets/shell-app.bundle",
